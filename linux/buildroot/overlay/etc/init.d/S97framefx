#!/bin/sh
case "$1" in
    start)
        case " $(cat /proc/cmdline) " in
            *" axi_lab.framefx=1 "*) ;;
            *) exit 0 ;;
        esac
        run_demo() {
            modprobe framefx || return 1
            mkdir -p /evidence || return 1
            mount -t 9p -o trans=virtio,version=9p2000.L evidence /evidence || return 1
            case " $(cat /proc/cmdline) " in
                *" axi_lab.fault=1 "*)
                    if framefx-test --headless --timeout-ms 5000 --output /evidence; then return 1; fi
                    if rmmod framefx; then return 1; fi
                    if framefx-test --headless --output /evidence; then return 1; fi
                    echo FRAMEFX_FAULT_PASS
                    return 0
                    ;;
            esac
            framefx-probe || return 1
            cma_alloc_before=$(cat /sys/kernel/mm/cma/*/alloc_pages_success) || return 1
            cma_free_before=$(cat /sys/kernel/mm/cma/*/release_pages_success) || return 1
            expected_error=0
            case " $(cat /proc/cmdline) " in
                *" axi_lab.axi_error=2 "*) expected_error=2 ;;
                *" axi_lab.axi_error=3 "*) expected_error=3 ;;
                *) framefx-lifecycle || return 1 ;;
            esac
            for shape in small medium narrow maximum; do
                case "$shape" in
                    small) set -- 320 240 1 1 ;;
                    medium) set -- 640 480 42 1 ;;
                    narrow) set -- 65 9 2026 3 ;;
                    maximum) set -- 1024 1024 7 1 ;;
                esac
                mkdir -p "/evidence/$shape" || return 1
                extra=
                if test "$shape" = small && test "$expected_error" != 0; then extra="--expect-error $expected_error"; fi
                framefx-test --width "$1" --height "$2" --seed "$3" --repeat "$4" --mode all --headless --selftest $extra --output "/evidence/$shape" || return 1
            done
            cat /proc/interrupts
            rmmod framefx || return 1
            modprobe framefx || return 1
            mkdir -p /evidence/reload || return 1
            framefx-test --width 3 --height 3 --mode all --headless --selftest --output /evidence/reload || return 1
            rmmod framefx || return 1
            sync
            umount /evidence || return 1
            cma_alloc_after=$(cat /sys/kernel/mm/cma/*/alloc_pages_success) || return 1
            cma_free_after=$(cat /sys/kernel/mm/cma/*/release_pages_success) || return 1
            allocated=$((cma_alloc_after - cma_alloc_before))
            released=$((cma_free_after - cma_free_before))
            echo "FRAMEFX_CMA allocated_pages=$allocated released_pages=$released"
            test "$allocated" -gt 0 && test "$allocated" = "$released" || return 1
            echo FRAMEFX_CMA_PASS
            echo FRAMEFX_UNLOAD_RELOAD_PASS
        }
        if run_demo; then echo AXI_LAB_FRAMEFX_PASS; else echo AXI_LAB_FRAMEFX_FAIL; fi
        poweroff
        ;;
esac

#!/bin/sh
case "$1" in
    start)
        case " $(cat /proc/cmdline) " in
            *" axi_lab.benchmark=1 "*) ;;
            *) exit 0 ;;
        esac
        run_benchmark() {
            mount -t debugfs debugfs /sys/kernel/debug || return 1
            test "$(cat /sys/kernel/debug/dma-api/disabled)" = N || return 1
            test "$(cat /sys/kernel/debug/dma-api/error_count)" = 0 || return 1
            modprobe framefx || return 1
            mkdir -p /evidence || return 1
            mount -t 9p -o trans=virtio,version=9p2000.L evidence /evidence || return 1
            allocated_before=$(cat /sys/kernel/mm/cma/*/alloc_pages_success) || return 1
            released_before=$(cat /sys/kernel/mm/cma/*/release_pages_success) || return 1
            for mode in 0 1 2 3; do
                for contend in 0 1; do
                    output="/evidence/mode-$mode-control-$contend"
                    mkdir "$output" || return 1
                    framefx-bench 65 9 "$mode" 4 2 "$contend" "$output" > "$output/benchmark.jsonl" || return 1
                done
            done
            cat /proc/interrupts > /evidence/interrupts.txt || return 1
            test "$(cat /sys/module/framefx/refcnt)" = 0 || return 1
            rmmod framefx || return 1
            allocated_after=$(cat /sys/kernel/mm/cma/*/alloc_pages_success) || return 1
            released_after=$(cat /sys/kernel/mm/cma/*/release_pages_success) || return 1
            allocated=$((allocated_after - allocated_before))
            released=$((released_after - released_before))
            echo "FRAMEFX_CMA allocated_pages=$allocated released_pages=$released"
            test "$allocated" -gt 0 && test "$allocated" = "$released" || return 1
            test "$(awk '/ debug_locks:/{print $2}' /proc/lockdep_stats)" = 1 || return 1
            test "$(cat /sys/kernel/debug/dma-api/disabled)" = N || return 1
            test "$(cat /sys/kernel/debug/dma-api/error_count)" = 0 || return 1
            echo FRAMEFX_BENCH_KERNEL_PASS
            sync
            umount /evidence || return 1
        }
        if run_benchmark; then echo AXI_LAB_FRAMEFX_PASS; else echo AXI_LAB_FRAMEFX_FAIL; fi
        poweroff
        ;;
esac
